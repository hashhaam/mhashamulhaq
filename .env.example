# Copy to .env.local and fill in. Never commit real secrets.

# Resend (transactional email — contact form)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional after verifying your sending domain. Defaults to Resend's test sender.
CONTACT_FROM_EMAIL=

# Supabase (server-side lead storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
